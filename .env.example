# Copy to .env.local for local development; never commit a populated copy.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Server-only secret key, normally beginning sb_secret_. Never use NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# A new demo-only password, 12+ characters. Share privately with reviewers.
REVIEWER_PASSWORD=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# Use the exact https://YOUR_SITE.netlify.app origin when deployed.
APP_URL=http://localhost:3000
